# Optional. Without a key the API uses the deterministic demo engine.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Team-shared format is also supported. OPENAI_* takes precedence when both exist.
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o
AI_MODE=auto
PORT=8787
WEB_ORIGIN=http://localhost:5173
